# ==============================================================================
# OpenWebUI PhotoAgent 전용 커스텀 Dockerfile
# 최신 OpenWebUI 베이스에 이미지/RAW 파일 처리 라이브러리를 사전 빌드합니다.
# ==============================================================================

FROM ghcr.io/open-webui/open-webui:main

USER root

# 필요한 시스템 라이브러리 및 Python 패키지 설치
COPY requirements.txt /tmp/requirements.txt

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libraw-dev \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements.txt

# 작업 디렉토리 권한 설정
RUN mkdir -p /app/backend/data/uploads/photo_editor \
    /app/backend/data/uploads/raw_processor \
    /app/backend/data/uploads/raw_temp \
    && chown -R 1000:1000 /app/backend/data/uploads

USER 1000
